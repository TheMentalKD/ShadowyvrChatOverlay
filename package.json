{
  "name": "stream-chat-overlay",
  "version": "2.1.1",
  "description": "Shadowyvr Stream Chat Overlay",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "MentalKD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheMentalKD/ShadowyvrChatOverlay.git"
  },
  "homepage": "https://github.com/TheMentalKD/ShadowyvrChatOverlay#readme",
  "bugs": {
    "url": "https://github.com/TheMentalKD/ShadowyvrChatOverlay/issues"
  },
  "main": "src/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "dist": "electron-builder --publish always",
    "pack": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "tmi.js": "^1.8.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.7",
    "eslint": "^10.8.1",
    "globals": "^17.11.0"
  },
  "build": {
    "appId": "com.shadowyvr.chatoverlay",
    "productName": "Shadowyvr Chat Overlay",
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "TheMentalKD",
      "repo": "ShadowyvrChatOverlay"
    }
  }
}
